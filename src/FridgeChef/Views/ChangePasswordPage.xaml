<!-- Figma "20. Change password". Shown only for email accounts (Google accounts have no password). -->
<ContentPage x:Class="FridgeChef.Views.ChangePasswordPage"
             xmlns:vm="clr-namespace:FridgeChef.Core.ViewModels;assembly=FridgeChef.Core"
             xmlns:res="clr-namespace:FridgeChef.Core.Resources;assembly=FridgeChef.Core"
             x:DataType="vm:ChangePasswordViewModel"
             Shell.TabBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="12">
            <HorizontalStackLayout Spacing="12" Margin="0,0,0,8">
                <Image Source="ic_chevron_left.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"
                       SemanticProperties.Description="{x:Static res:AppResources.Back}">
                    <Image.GestureRecognizers><TapGestureRecognizer Command="{Binding BackCommand}" /></Image.GestureRecognizers>
                </Image>
                <Label Text="{x:Static res:AppResources.ChangePassword}" Style="{StaticResource Title}" />
            </HorizontalStackLayout>

            <Label Text="{x:Static res:AppResources.CurrentPassword}" Style="{StaticResource OliveBold}" />
            <Border Style="{StaticResource InputBox}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Image Source="ic_lock.png" Style="{StaticResource InputIcon}" />
                    <Entry Grid.Column="1" Text="{Binding Current}" Placeholder="{x:Static res:AppResources.CurrentPassword}" IsPassword="{Binding HidePassword}" />
                    <ImageButton Grid.Column="2" Source="ic_eye.png" Style="{StaticResource ThemedIcon}" Command="{Binding TogglePasswordCommand}" WidthRequest="24" HeightRequest="24"
                                 Padding="0" BackgroundColor="Transparent" SemanticProperties.Description="{x:Static res:AppResources.ShowPassword}" />
                </Grid>
            </Border>

            <Label Text="{x:Static res:AppResources.NewPassword}" Style="{StaticResource OliveBold}" />
            <Border Style="{StaticResource InputBox}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="ic_lock.png" Style="{StaticResource InputIcon}" />
                    <Entry Grid.Column="1" Text="{Binding New}" Placeholder="{x:Static res:AppResources.NewPassword}" IsPassword="{Binding HidePassword}" />
                </Grid>
            </Border>
            <Label Text="{x:Static res:AppResources.AtLeast8}" Style="{StaticResource Muted}" FontSize="12" Margin="0,-6,0,0" />

            <Label Text="{x:Static res:AppResources.ConfirmNewPassword}" Style="{StaticResource OliveBold}" />
            <Border Style="{StaticResource InputBox}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="ic_lock.png" Style="{StaticResource InputIcon}" />
                    <Entry Grid.Column="1" Text="{Binding Confirm}" Placeholder="{x:Static res:AppResources.RepeatNewPassword}"
                           IsPassword="{Binding HidePassword}" ReturnCommand="{Binding UpdateCommand}" />
                </Grid>
            </Border>

            <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="{x:Static res:AppResources.UpdatePassword}" Command="{Binding UpdateCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
