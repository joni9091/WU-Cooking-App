<!-- Figma "3.1 Sign-up": email, password, confirm password. Google users skip this and go straight to Profile setup. -->
<ContentPage x:Class="FridgeChef.Views.Auth.SignUpPage"
             xmlns:vm="clr-namespace:FridgeChef.Core.ViewModels;assembly=FridgeChef.Core"
             xmlns:res="clr-namespace:FridgeChef.Core.Resources;assembly=FridgeChef.Core"
             x:DataType="vm:SignUpViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource AuthPadding}" Spacing="20">
            <VerticalStackLayout Spacing="6" Margin="4,0,0,4">
                <Label Text="{x:Static res:AppResources.SignUpTitle}" Style="{StaticResource AuthTitle}" />
                <Label Text="{x:Static res:AppResources.SignUpSubtitle}" Style="{StaticResource OliveText}"
                       FontFamily="{DynamicResource AppHeadingFont}" FontSize="15" />
            </VerticalStackLayout>

            <Border Style="{StaticResource InputBox}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="ic_mail.png" Style="{StaticResource InputIcon}" />
                    <Entry Grid.Column="1" Text="{Binding Email}" Placeholder="{x:Static res:AppResources.EmailPlaceholder}"
                           Keyboard="Email" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                </Grid>
            </Border>

            <Border Style="{StaticResource InputBox}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Image Source="ic_key_round.png" Style="{StaticResource InputIcon}" />
                    <Entry Grid.Column="1" Text="{Binding Password}" Placeholder="{x:Static res:AppResources.PasswordPlaceholder}"
                           IsPassword="{Binding HidePassword}" />
                    <ImageButton Grid.Column="2" Source="{Binding EyeIcon}" Command="{Binding TogglePasswordCommand}"
                                 WidthRequest="24" HeightRequest="24" Padding="0" BackgroundColor="Transparent"
                                 SemanticProperties.Description="{x:Static res:AppResources.ShowPassword}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource InputBox}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Image Source="ic_key_round.png" Style="{StaticResource InputIcon}" />
                    <Entry Grid.Column="1" Text="{Binding Confirm}" Placeholder="{x:Static res:AppResources.ConfirmPasswordPlaceholder}"
                           IsPassword="{Binding HidePassword}" ReturnType="Done" ReturnCommand="{Binding SignUpCommand}" />
                    <ImageButton Grid.Column="2" Source="{Binding EyeIcon}" Command="{Binding TogglePasswordCommand}"
                                 WidthRequest="24" HeightRequest="24" Padding="0" BackgroundColor="Transparent"
                                 SemanticProperties.Description="{x:Static res:AppResources.ShowPassword}" />
                </Grid>
            </Border>

            <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" />
            <Label Text="{Binding Info}" Style="{StaticResource OliveBold}" HorizontalTextAlignment="Center" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="{x:Static res:AppResources.SignUpButton}" Command="{Binding SignUpCommand}" />
            <Label Text="{x:Static res:AppResources.OrContinueWith}" Style="{StaticResource OliveText}" FontSize="16"
                   HorizontalTextAlignment="Center" />
            <Button Text="{x:Static res:AppResources.ContinueGoogle}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding GoogleCommand}" />

            <Label HorizontalTextAlignment="Center" Margin="0,40,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{x:Static res:AppResources.HaveAccount}" TextColor="{StaticResource Olive}" FontFamily="{DynamicResource AppBodyFont}" FontSize="15" />
                        <Span Text=" " />
                        <Span Text="{x:Static res:AppResources.SignIn}" TextColor="{StaticResource Olive}" FontFamily="{DynamicResource AppBodyBoldFont}" FontSize="15" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding GoCommand}" CommandParameter="login" /></Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
