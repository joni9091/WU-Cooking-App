<!-- Figma "3.2 Forgot-Pass", step 1. Step 2 (code + new password) reuses the same layout (owner chose a code, not a link). -->
<ContentPage x:Class="FridgeChef.Views.Auth.ForgotPasswordPage"
             xmlns:vm="clr-namespace:FridgeChef.Core.ViewModels;assembly=FridgeChef.Core"
             xmlns:res="clr-namespace:FridgeChef.Core.Resources;assembly=FridgeChef.Core"
             x:DataType="vm:ForgotPasswordViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="16">
            <HorizontalStackLayout Spacing="8">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoCommand}" CommandParameter="back" />
                </HorizontalStackLayout.GestureRecognizers>
                <Image Source="ic_chevron_left.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                <Label Text="{x:Static res:AppResources.Back}" Style="{StaticResource OliveText}"
                       FontFamily="{DynamicResource AppHeadingFont}" FontSize="20" />
            </HorizontalStackLayout>

            <Label Text="{x:Static res:AppResources.ForgotTitle}" Style="{StaticResource Title}" FontSize="38" Margin="0,12,0,0" />

            <!-- Step 1: email -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding AskEmail}">
                <Label Text="{x:Static res:AppResources.ForgotText}" Style="{StaticResource OliveText}" FontSize="15" />
                <Label Text="{x:Static res:AppResources.EmailLabel}" Style="{StaticResource OliveBold}" />
                <Border Style="{StaticResource InputBox}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_mail.png" Style="{StaticResource InputIcon}" />
                        <Entry Grid.Column="1" Text="{Binding Email}" Placeholder="you@email.com" Keyboard="Email"
                               IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ReturnCommand="{Binding SendCodeCommand}" />
                    </Grid>
                </Border>
                <Button Text="{x:Static res:AppResources.SendCode}" Command="{Binding SendCodeCommand}" />
            </VerticalStackLayout>

            <!-- Step 2: code from the email + new password -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding CodeSent}">
                <Label Text="{x:Static res:AppResources.CodeText}" Style="{StaticResource OliveText}" FontSize="15" />
                <Label Text="{x:Static res:AppResources.CodeLabel}" Style="{StaticResource OliveBold}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry Text="{Binding Code}" Placeholder="{x:Static res:AppResources.CodePlaceholder}" Keyboard="Numeric" MaxLength="10" />
                </Border>
                <Border Style="{StaticResource InputBox}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Image Source="ic_key_round.png" Style="{StaticResource InputIcon}" />
                        <Entry Grid.Column="1" Text="{Binding NewPassword}" Placeholder="{x:Static res:AppResources.NewPasswordPlaceholder}"
                               IsPassword="{Binding HidePassword}" ReturnCommand="{Binding SavePasswordCommand}" />
                        <ImageButton Grid.Column="2" Source="{Binding EyeIcon}" Command="{Binding TogglePasswordCommand}"
                                     WidthRequest="24" HeightRequest="24" Padding="0" BackgroundColor="Transparent"
                                     SemanticProperties.Description="{x:Static res:AppResources.ShowPassword}" />
                    </Grid>
                </Border>
                <Button Text="{x:Static res:AppResources.SavePassword}" Command="{Binding SavePasswordCommand}" />
            </VerticalStackLayout>

            <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="{x:Static res:AppResources.RememberedLogin}" Style="{StaticResource OliveBold}" HorizontalTextAlignment="Center">
                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding GoCommand}" CommandParameter="login" /></Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
