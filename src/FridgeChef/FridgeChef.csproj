<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android first. To add iOS later: <TargetFrameworks>net11.0-android;net11.0-ios</TargetFrameworks> -->
		<TargetFrameworks>net11.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>FridgeChef</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Fridge Chef</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.fridgechef.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android 7.0 (API 24): the lowest version .NET MAUI supports. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<!-- App icon from Figma ("26. App icon"); the yellow background matches its border so Android's round/squircle masks look right. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.8" Color="#FFF7B2" />

		<!-- Splash Screen -->
		<!-- Splash: logo on the app icon's dark brown (owner chose the common "match the icon" look). -->
		<MauiSplashScreen Include="Resources\Splash\splash_logo.png" Color="#433400" BaseSize="231,231" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FridgeChef.Core\FridgeChef.Core.csproj" />
	</ItemGroup>

</Project>
