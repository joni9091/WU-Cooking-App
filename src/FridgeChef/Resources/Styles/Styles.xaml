<?xml version="1.0" encoding="utf-8" ?>
<!-- Default looks for controls. Uses only values from Theme.xaml (no raw colours or sizes here).
     DynamicResource fonts let the font switch at once when the language changes. -->
<ResourceDictionary xmlns:views="clr-namespace:FridgeChef.Views">

    <!-- Figma has no title bar: each screen draws its own heading. -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="NavigationPage.HasNavigationBar" Value="False" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}" />
    </Style>

    <!-- Named label styles don't inherit the default one, so they all build on BaseLabel. -->
    <Style TargetType="Label" x:Key="BaseLabel">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="{DynamicResource AppLineHeight}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource TextDark}}" />
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource BaseLabel}" />

    <!-- Big olive serif heading, e.g. "Popular now". -->
    <Style TargetType="Label" x:Key="Title" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="{DynamicResource AppHeadingFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Olive}, Dark={StaticResource PaleYellow}}" />
    </Style>

    <!-- Recipe names on cards, e.g. "Lok Lak". -->
    <Style TargetType="Label" x:Key="Heading" BasedOn="{StaticResource Title}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
    </Style>

    <Style TargetType="Label" x:Key="Muted" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Grey}, Dark={StaticResource GreyDark}}" />
    </Style>

    <!-- Big olive serif page title, e.g. "Welcome Back!!" -->
    <Style TargetType="Label" x:Key="AuthTitle" BasedOn="{StaticResource Title}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeAuthTitle}" />
    </Style>

    <!-- Olive text: subtitles, field labels, links -->
    <Style TargetType="Label" x:Key="OliveText" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Olive}, Dark={StaticResource OliveLight}}" />
    </Style>

    <Style TargetType="Label" x:Key="OliveBold" BasedOn="{StaticResource OliveText}">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyBoldFont}" />
    </Style>

    <Style TargetType="Label" x:Key="ErrorText" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Main button: pale yellow with black bold text ("Sign in", "Finish") -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyBoldFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeInput}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PaleYellow}" />
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="CornerRadius" Value="24" />
    </Style>

    <!-- Second-choice button: grey with grey text ("Continue with Google") -->
    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeInput}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InputGrey}, Dark={StaticResource InputGreyDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Grey}, Dark={StaticResource GreyDark}}" />
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="CornerRadius" Value="24" />
    </Style>

    <!-- Grey rounded box that holds an icon and an Entry -->
    <Style TargetType="Border" x:Key="InputBox">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InputGrey}, Dark={StaticResource InputGreyDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="22,0" />
    </Style>

    <!-- Entries sit inside InputBox; the Android underline is removed in MauiProgram. -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeInput}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource TextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Grey}, Dark={StaticResource GreyDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Black icons on the page or in input boxes: light in dark mode (icons on pale-yellow/white buttons stay black). -->
    <Style TargetType="View" x:Key="ThemedIcon">
        <Setter Property="views:Icon.Tint" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource TextDark}}" />
    </Style>
    <Style TargetType="Image" x:Key="InputIcon">
        <Setter Property="views:Icon.Tint" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource TextDark}}" />
        <Setter Property="WidthRequest" Value="18" />
        <Setter Property="HeightRequest" Value="18" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Recipe cards (Figma Home / Saved): white, thin pale-yellow border, rounded -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{StaticResource PaleYellow}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- Rounded photo frame; grey shows while the photo loads (or if there is none) -->
    <Style TargetType="Border" x:Key="Photo">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InputGrey}, Dark={StaticResource InputGreyDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <!-- Recipe name on cards, e.g. "Lok Lak" -->
    <Style TargetType="Label" x:Key="CardTitle" BasedOn="{StaticResource Title}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Short description: always 2 lines max (brief) -->
    <Style TargetType="Label" x:Key="CardDescription" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- "420 kcal / serving" pill -->
    <Style TargetType="Border" x:Key="KcalPill">
        <Setter Property="BackgroundColor" Value="{StaticResource PaleYellow}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- Always dark olive: it sits on the pale-yellow pill in both modes -->
    <Style TargetType="Label" x:Key="KcalText" BasedOn="{StaticResource OliveBold}">
        <Setter Property="TextColor" Value="{StaticResource Olive}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Category / info chips: white with pale-yellow border; selected = pale yellow fill + olive border -->
    <Style TargetType="Border" x:Key="Chip">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{StaticResource PaleYellow}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <Style TargetType="Border" x:Key="ChipSelected" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PaleYellow}, Dark={StaticResource ChipDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Olive}, Dark={StaticResource OliveLight}}" />
    </Style>

    <!-- Square pale-yellow icon buttons (Filter, Fridge) -->
    <Style TargetType="Border" x:Key="IconButton">
        <Setter Property="BackgroundColor" Value="{StaticResource PaleYellow}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="WidthRequest" Value="52" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <!-- Loading placeholder blocks (Figma 25) -->
    <Style TargetType="Border" x:Key="Skeleton">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SkeletonLight}, Dark={StaticResource SkeletonDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource Olive}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Olive}" />
    </Style>

    <!-- Tab bar colours. Its floating rounded shape is drawn in Platforms/Android/FloatingTabBarHandler.cs. -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource PaleYellow}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Icon}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Icon}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>

</ResourceDictionary>
